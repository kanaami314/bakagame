; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bakagame"
config/description="古き良き探索型王道RPG風バカゲー ― 死んで学ぶ勇者の物語"
config/version="0.2.1"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
GameState="*res://scripts/autoload/GameState.gd"
PartyData="*res://scripts/autoload/PartyData.gd"
Dialogue="*res://scripts/autoload/Dialogue.gd"
BattleSystem="*res://scripts/autoload/BattleSystem.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=1280
window/size/window_height_override=896
; viewport ではなく canvas_items にすることで、フォントが最終解像度で
; ラスタライズされ文字がぼやけなくなる。タイルは nearest フィルタのまま拡大される。
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/subwindows/embed_subwindows=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[physics]

2d/default_gravity=0
